# Copiá este archivo a .env y completá con tus credenciales de Supabase.
# Dashboard: https://supabase.com/dashboard → tu proyecto → Settings → API
#
# .env NUNCA se sube a GitHub (está en .gitignore).

SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_ANON_KEY=eyJ...tu_clave_anon_publica

# Nunca pongas aquí la service_role key (solo servidor / panel admin).
